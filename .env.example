# Environment Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./loan_default.db
# For PostgreSQL in Docker or local instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_db

# Risk Classification Thresholds
LOW_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.60

# Model Paths & MLflow
MODEL_DIR=./models
ACTIVE_MODEL=XGBoost
MLFLOW_TRACKING_URI=./mlruns
EXPERIMENT_NAME=loan-default-prediction
DATA_PATH=./data/loan_train.csv
